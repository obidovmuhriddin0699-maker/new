# Secrets — never commit
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Local databases / data
*.db
*.sqlite3
backend/data/
# Root-level media folder only (uploads live in backend/data/media or a Docker volume).
# A bare "media/" would also hide frontend/src/app/(panel)/media and app/media.
/media/

# Node / Next.js
node_modules/
.next/
out/
frontend/next-env.d.ts
frontend/test-results/
frontend/playwright-report/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Celery beat schedule (local runs)
celerybeat-schedule*

# Production backups (never commit)
/backups/
/.deploy/
