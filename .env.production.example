# Production settings for docker-compose.prod.yml. Copy to .env.production (git-ignored)
# and replace EVERY "change-me" value. Never commit the real file.
#
# Generate secrets (PowerShell or bash):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                  # passwords / JWT secret
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     # TOKEN_ENCRYPTION_KEYS
#   (no local Python? docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(48))")

# --- Images / exposure
IMAGE_TAG=prod
PANEL_BIND=127.0.0.1            # keep 127.0.0.1: put a TLS reverse proxy in front (PHASE 12)
PANEL_PORT=3000

# --- PostgreSQL (owner runs migrations; the app uses the least-privilege role)
POSTGRES_DB=muxriddin
POSTGRES_USER=muxriddin_owner
POSTGRES_PASSWORD=change-me-owner-password
APP_DB_USER=muxriddin_app
APP_DB_PASSWORD=change-me-app-password-min-16

# --- Redis (rate limiting, Celery broker)
REDIS_PASSWORD=change-me-redis-password

# --- Core security (startup is refused if these are weak or missing)
JWT_SECRET_KEY=change-me-at-least-32-characters-random
TOKEN_ENCRYPTION_KEYS=change-me-fernet-key
CORS_ORIGINS=https://panel.example.com
ALLOWED_HOSTS=panel.example.com,backend,localhost,127.0.0.1
PANEL_PUBLIC_URL=https://panel.example.com
SESSION_COOKIE_SECURE=true
# true only when a reverse proxy you control sets X-Forwarded-For (PHASE 12)
TRUST_PROXY_HEADERS=false

# --- AI (Ollama on the host by default; or --profile ollama and http://ollama:11434)
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Meta / Instagram (see README §9-13). Keep dry run until you have tested on your account.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://panel.example.com/instagram/callback
META_DRY_RUN=true
MEDIA_PUBLIC_BASE_URL=https://panel.example.com

# --- Telegram (optional: docker compose ... --profile telegram up -d)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- First admin (run once: docker compose ... run --rm backend python -m app.cli create-admin --email you@example.com)
