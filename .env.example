# =============================================================
# MUXRIDDIN AI INSTAGRAM MANAGER — environment template
# Copy to .env and fill in. NEVER commit .env.
#   PowerShell:  Copy-Item .env.example .env
# =============================================================

# --- App ---
APP_ENV=development          # development | test | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Comma-separated list of allowed frontend origins (no "*" in production)
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Empty -> SQLite fallback at SQLITE_PATH (local dev without PostgreSQL)
DATABASE_URL=
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://muxriddin:muxriddin_dev@localhost:5432/muxriddin
SQLITE_PATH=./data/muxriddin.db

# Used by docker-compose for the postgres container (dev only)
POSTGRES_USER=muxriddin
POSTGRES_PASSWORD=muxriddin_dev
POSTGRES_DB=muxriddin

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- OAuth token encryption (Fernet) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the NEW key first, keep old keys after it, comma-separated.
TOKEN_ENCRYPTION_KEYS=

# --- AI provider ---
AI_PROVIDER=ollama             # ollama | mock (mock = deterministic, tests/demos, refused in production)
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:3b
AI_TIMEOUT_SECONDS=120
AI_TEMPERATURE=0.6
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RESPONSE_CHARS=60000
AI_STRUCTURED_MAX_ATTEMPTS=2   # 1 generation + 1 repair attempt for invalid JSON
AI_JOBS_MODE=sync              # sync (inside the request) | celery (background, HTTP 202)
AI_MAX_ACTIVE_JOBS_PER_USER=3

# --- Media generation (no real provider in PHASE 3) ---
IMAGE_PROVIDER=none            # none -> "not_configured" | mock -> placeholder only
VIDEO_PROVIDER=none

# --- Approval policy (PHASE 6) ---
APPROVAL_MAX_AGE_HOURS=0                     # 0 = approvals do not expire
APPROVAL_REQUIRE_DIFFERENT_APPROVER=false    # "four eyes": approver != author of the version
APPROVAL_REMINDER_HOURS=24                   # Telegram digest for content waiting longer (0 = off)

# --- Telegram bot (PHASE 5) ---
# 1) @BotFather -> /newbot -> token   2) your numeric Telegram id: @userinfobot
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=                    # secret — never commit
TELEGRAM_BOT_USERNAME=                 # without @, for the "open in Telegram" link
TELEGRAM_ALLOWED_USER_IDS=             # comma-separated numeric ids, e.g. 123456789
TELEGRAM_ACTION_TTL_HOURS=72           # lifetime of approve/edit/reject buttons
TELEGRAM_LINK_CODE_TTL_MINUTES=10
TELEGRAM_NOTIFY_INTERVAL_SECONDS=15
PANEL_PUBLIC_URL=http://localhost:3000 # "open in panel" links + Meta data-deletion status URL

# --- Meta / Instagram (PHASE 7: Instagram API with Instagram Login) ---
# See README sections 9-13 and docs/META_OAUTH.md. Never commit real values.
# Meta App Dashboard -> Instagram -> API setup with Instagram login -> Business login settings:
META_APP_ID=                 # "Instagram app ID" (not the Facebook app ID)
META_APP_SECRET=             # "Instagram app secret" - server only, never sent to the browser
# Must exactly match a "Valid OAuth Redirect URI" in the dashboard. Meta requires https
# (use a tunnel such as cloudflared/ngrok for local development).
META_REDIRECT_URI=           # e.g. https://panel.example.com/instagram/callback
# Requested at consent time (comma-separated). Required ones must be granted or the
# connection is refused with a clear message.
META_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights
META_REQUIRED_SCOPES=instagram_business_basic,instagram_business_content_publish
META_TOKEN_REFRESH_WINDOW_DAYS=15  # refresh long-lived (60-day) tokens this many days before expiry
META_OAUTH_STATE_TTL_MINUTES=10
META_LOGIN_MODE=instagram    # instagram (default) | facebook
META_GRAPH_API_VERSION=v26.0 # verify against the official Meta changelog
META_DRY_RUN=true            # true = never publish to a real account
# Tokens are stored only encrypted: TOKEN_ENCRYPTION_KEYS above MUST be set before connecting.

# --- Frontend (Next.js server side; nothing here is sent to the browser) ---
BACKEND_URL=http://localhost:8000      # where the Next.js proxy reaches the FastAPI backend
SESSION_COOKIE_SECURE=auto             # auto = Secure flag on HTTPS only | true | false
